#!/usr/bin/env bash
# COSMOS — Orchestrator CLI for RSI Ecosystem
set -e

COSMOS_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

show_help() {
  cat <<HELP
Usage: cosmos <command> [options]

Commands:
  dashboard               Launch the unified web dashboard + all services
  status                  Show status of all COSMOS components
  start [component]       Start a component (or all if omitted)
  stop [component]        Stop a component (or all if omitted)
  list                    List all components and their status
  logs [component]        Tail logs for a component
  build [component]       Build a component
  test [component]        Test a component
  update                  Git pull all components
  help                    Show this help

Components:
  space        Prompt engine, CLI, spec generation
  mykb         Daily knowledge base (Obsidian wiki)
  rsis3        3-loop RSI system
  rsisb        Earlier RSIS version (archived)

Examples:
  cosmos dashboard         # Launch dashboard + all services
  cosmos status            # Check all components
  cosmos start space       # Start SPACE servers
  cosmos logs rsis3        # Tail RSIS3 logs
  cosmos build             # Build all components
HELP
}

# Component metadata
declare -A COMPONENT_DIR
declare -A COMPONENT_DESC
declare -A COMPONENT_TYPE

COMPONENT_DIR[space]="$COSMOS_DIR/components/space"
COMPONENT_DIR[mykb]="$COSMOS_DIR/components/mykb"
COMPONENT_DIR[rsis3]="$COSMOS_DIR/components/rsis3"
COMPONENT_DIR[rsisb]="$COSMOS_DIR/components/rsisb"

COMPONENT_DESC[space]="Prompt engine, CLI, spec generation"
COMPONENT_DESC[mykb]="Daily knowledge base (Obsidian wiki)"
COMPONENT_DESC[rsis3]="3-loop RSI system"
COMPONENT_DESC[rsisb]="Earlier RSIS version"

COMPONENT_TYPE[space]="typescript"
COMPONENT_TYPE[mykb]="markdown+python"
COMPONENT_TYPE[rsis3]="python"
COMPONENT_TYPE[rsisb]="python"

cmd_dashboard() {
  echo "🌌 Launching COSMOS Dashboard + Services..."
  cd "$COSMOS_DIR"
  exec ./start.sh
}

cmd_status() {
  echo ""
  echo "╔════════════════════════════════════════╗"
  echo "║       🌌  COSMOS System Status        ║"
  echo "╚════════════════════════════════════════╝"
  echo ""
  printf "  %-10s %-12s %-8s %s\n" "Component" "Type" "Status" "Description"
  printf "  %-10s %-12s %-8s %s\n" "─────────" "────" "──────" "───────────"
  
  for comp in space mykb rsis3 rsisb; do
    local dir="${COMPONENT_DIR[$comp]}"
    local type="${COMPONENT_TYPE[$comp]}"
    local desc="${COMPONENT_DESC[$comp]}"
    if [ -d "$dir" ]; then
      local running=0
      if [ "$comp" = "space" ]; then
        pgrep -f "serve-meta.mjs" >/dev/null 2>&1 && running=1
      fi
      if [ "$running" = "1" ]; then
        printf "  🟢 %-7s %-12s %-8s %s\n" "$comp" "$type" "running" "$desc"
      else
        printf "  ⚪ %-7s %-12s %-8s %s\n" "$comp" "$type" "idle" "$desc"
      fi
    else
      printf "  🔴 %-7s %-12s %-8s %s\n" "$comp" "$type" "missing" "$desc"
    fi
  done
  echo ""
}

cmd_list() {
  echo ""
  echo "COSMOS Components"
  echo "═════════════════"
  echo ""
  for comp in space mykb rsis3 rsisb; do
    local dir="${COMPONENT_DIR[$comp]}"
    local type="${COMPONENT_TYPE[$comp]}"
    local desc="${COMPONENT_DESC[$comp]}"
    if [ -d "$dir" ]; then
      local files=$(find "$dir" -type f -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null | wc -l)
      printf "  📦 %-10s %-12s %4d files  — %s\n" "$comp" "($type)" "$files" "$desc"
    else
      printf "  ❌ %-10s (not found)\n" "$comp"
    fi
  done
  echo ""
}

cmd_start() {
  local target="${1:-all}"
  if [ "$target" = "all" ]; then
    echo "Starting all COSMOS components..."
    if [ -f "$COSMOS_DIR/components/space/serve-meta.mjs" ]; then
      cd "$COSMOS_DIR/components/space"
      node serve-meta.mjs 8899 > /dev/null 2>&1 &
      echo "  🟢 SPACE Meta Viewer → :8899"
    fi
    if [ -f "$COSMOS_DIR/components/space/serve-ui.mjs" ]; then
      cd "$COSMOS_DIR/components/space"
      node serve-ui.mjs 8888 > /dev/null 2>&1 &
      echo "  🟢 SPACE Web UI → :8888"
    fi
    cd "$COSMOS_DIR"
    if [ -f "$COSMOS_DIR/infra/heartbeat/heartbeat.mjs" ]; then
      node "$COSMOS_DIR/infra/heartbeat/heartbeat.mjs" --interval 30 --restart > "$COSMOS_DIR/sentry.log" 2>&1 &
      echo "  ❤️  Sentry heartbeat started"
    fi
    cd "$COSMOS_DIR"
  else
    local dir="${COMPONENT_DIR[$target]}"
    if [ -z "$dir" ]; then
      echo "Unknown component: $target"
      exit 1
    fi
    echo "Starting $target..."
    case "$target" in
      space)
        cd "$dir"
        node serve-meta.mjs 8899 > /dev/null 2>&1 &
        echo "  🟢 Meta Viewer → :8899"
        node serve-ui.mjs 8888 > /dev/null 2>&1 &
        echo "  🟢 Web UI → :8888"
        ;;
      *)
        echo "  ⚪ No server to start for $target"
        ;;
    esac
    cd "$COSMOS_DIR"
  fi
}

cmd_stop() {
  local target="${1:-all}"
  if [ "$target" = "all" ]; then
    echo "Stopping all COSMOS components..."
    pkill -f "serve-meta.mjs" 2>/dev/null && echo "  🔴 SPACE Meta Viewer" || true
    pkill -f "serve-ui.mjs" 2>/dev/null && echo "  🔴 SPACE Web UI" || true
    pkill -f "heartbeat.mjs" 2>/dev/null && echo "  🔴 Sentry heartbeat" || true
    echo "  ✅ All stopped"
  else
    case "$target" in
      space)
        pkill -f "serve-meta.mjs" 2>/dev/null && echo "  🔴 Meta Viewer" || true
        pkill -f "serve-ui.mjs" 2>/dev/null && echo "  🔴 Web UI" || true
        ;;
      *)
        echo "  ⚪ No server to stop for $target"
        ;;
    esac
  fi
}

cmd_logs() {
  local target="${1:-all}"
  local logfile="$COSMOS_DIR/sentry.log"
  if [ -f "$logfile" ]; then
    if [ "$target" = "all" ]; then
      tail -f "$logfile"
    else
      tail -f "$logfile" | grep --line-buffered "$target"
    fi
  else
    echo "No logs yet. Start components first."
  fi
}

cmd_build() {
  local target="${1:-all}"
  for comp in space mykb rsis3 rsisb; do
    if [ "$target" != "all" ] && [ "$target" != "$comp" ]; then continue; fi
    local dir="${COMPONENT_DIR[$comp]}"
    if [ ! -d "$dir" ]; then continue; fi
    echo "Building $comp..."
    case "${COMPONENT_TYPE[$comp]}" in
      typescript)
        if [ -f "$dir/package.json" ]; then
          cd "$dir" && npm run build 2>/dev/null && echo "  ✅ $comp built" || echo "  ⚠️  $comp build skipped"
        fi
        ;;
      python)
        echo "  ⚪ Python component — no build step"
        ;;
    esac
  done
  cd "$COSMOS_DIR"
}

cmd_test() {
  local target="${1:-all}"
  for comp in space mykb rsis3 rsisb; do
    if [ "$target" != "all" ] && [ "$target" != "$comp" ]; then continue; fi
    local dir="${COMPONENT_DIR[$comp]}"
    if [ ! -d "$dir" ]; then continue; fi
    echo "Testing $comp..."
    case "${COMPONENT_TYPE[$comp]}" in
      typescript)
        if [ -f "$dir/package.json" ]; then
          cd "$dir" && npm test 2>/dev/null && echo "  ✅ $comp tests passed" || echo "  ⚠️  $comp tests had issues"
        fi
        ;;
      python)
        if [ -f "$dir/pyproject.toml" ] || [ -f "$dir/requirements.txt" ]; then
          (cd "$dir" && python3 -m pytest 2>/dev/null) && echo "  ✅ $comp tests passed" || echo "  ⚪ $comp no pytest found"
        fi
        ;;
    esac
  done
  cd "$COSMOS_DIR"
}

cmd_update() {
  echo "COSMOS components are local copies. To update:"
  echo "  rsync -a ~/dev/space/ components/space/"
  echo "  rsync -a ~/dev/codex/mykb/ components/mykb/"
  echo "  git pull"
}

case "${1:-help}" in
  dashboard|dash|gui) cmd_dashboard ;;
  status|st) cmd_status ;;
  list|ls) cmd_list ;;
  start) shift; cmd_start "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  build) shift; cmd_build "$@" ;;
  test) shift; cmd_test "$@" ;;
  update) cmd_update ;;
  help|--help|-h) show_help ;;
  *) echo "Unknown: $1"; show_help; exit 1 ;;
esac
