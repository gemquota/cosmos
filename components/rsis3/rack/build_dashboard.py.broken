        <div class="flex items-center gap-3">
          <span class="text-lg">{{ pulseExpandIcon(pulse.id) }}</span>
          <span class="px-2 py-0.5 bg-slate-900 font-mono text-xs font-bold rounded text-indigo-400 border border-slate-700">#{{ pulse.id }}</span>
          <div>
            <span class="text-sm font-semibold text-slate-200">{{ pulse.goals_count }} goals &middot; {{ pulse.approved }} approved</span>
            <span class="text-[10px] text-slate-500 ml-2">{{ formatTime(pulse.ts_start) }} &middot; {{ pulse.type.slice(0,15) }}{{ pulse.type.length > 15 ? '\u2026' : '' }}</span>
          </div>
